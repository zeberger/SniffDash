# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# Values here are read by sniffdash.config.load_settings(); real environment
# variables always take precedence over this file.

# --- AI Q&A (Phase 3): Google Gemini ---
# Free key: https://aistudio.google.com/apikey
# In AI Studio, restrict the key to the "Generative Language API" (unrestricted keys are rejected).
GEMINI_API_KEY=your-key-here
# Optional: any model your key can use that supports function calling (see AI Studio).
# gemini-2.5-* is closed to new users; gemini-3.5-flash is verified to work.
GEMINI_MODEL=gemini-3.5-flash
# Optional: used automatically when the main model's free quota is used up or it is
# overloaded; a "lite" model has its own separate quota. Empty value = no fallback.
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Optional: how much the model "thinks" before answering (minimal / low / medium / high).
# "low" answers our lookup-style questions ~4x faster. Empty value = the model's default.
# GEMINI_THINKING_LEVEL=low

# --- Parsing (Phase 1) ---
# Optional: full path to tshark. Rarely needed: the default Wireshark install
# folders are probed automatically.
# TSHARK_PATH=C:\Program Files\Wireshark\tshark.exe
